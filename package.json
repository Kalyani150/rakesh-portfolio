{
  "name": "rakesh-portfolio",
  "private": true,
  "workspaces": [
    "website",
    "admin"
  ],
  "scripts": {
    "dev:website": "npm run dev -w website",
    "dev:admin": "npm run dev -w admin",
    "build": "npm run build --workspaces",
    "build:website": "npm run build -w website",
    "build:admin": "npm run build -w admin",
    "build:all": "npm run build:website && npm run build:admin && node scripts/merge-admin.mjs"
  }
}
